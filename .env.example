# Copy to .env and fill in. Never commit the real .env.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/nara-catalog-mcp`.
# Variables already set in the environment take precedence.

# API key issued by the National Archives Catalog API team.
# Request one at https://www.archives.gov/research/catalog/help/api
NARA_API_KEY=your-key-here

# Optional: directory for the on-disk response cache.
# NARA_CACHE_DIR=~/.cache/nara-catalog-mcp

# Optional: HTTP timeout in seconds (default 60).
# NARA_TIMEOUT=60

# Optional: calls per month your key allows (default 10000). Only used to
# report headroom in api_budget; it does not change what the API permits.
# NARA_MONTHLY_CALL_BUDGET=10000
